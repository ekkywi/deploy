# Application
NODE_ENV=production
APP_PORT=3000

# Required: used to sign session tokens
JWT_SECRET=replace-with-a-long-random-string

# Required: encrypts secret env vars and worker auth tokens at rest (AES-256-GCM).
# Use a long random string, 64 hex chars, or 32-byte base64.
ENCRYPTION_KEY=replace-with-another-long-random-string

# Optional: fail PENDING/BUILDING deployments older than this many minutes (default 45).
# DEPLOY_TIMEOUT_MINUTES=45
# Optional: how often the teardown worker sweeps stuck deploys (ms, default 60000).
# STUCK_DEPLOY_SWEEP_INTERVAL_MS=60000

# PostgreSQL (used by docker-compose and local development)
POSTGRES_USER=deploy
POSTGRES_PASSWORD=deploy
POSTGRES_DB=deploy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deploy:deploy@localhost:5432/deploy?schema=public

# Redis (teardown / background jobs)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# First boot seed (docker-compose web service)
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@local.com
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
