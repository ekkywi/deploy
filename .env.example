# Application
NODE_ENV=production
APP_PORT=3000

# Required: used to sign session tokens
JWT_SECRET=replace-with-a-long-random-string

# PostgreSQL (used by docker-compose and local development)
POSTGRES_USER=deploy
POSTGRES_PASSWORD=deploy
POSTGRES_DB=deploy
POSTGRES_PORT=5432
DATABASE_URL=postgresql://deploy:deploy@localhost:5432/deploy?schema=public

# Redis (teardown / background jobs)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# First boot seed (docker-compose web service)
SEED_ON_START=true
SEED_ADMIN_EMAIL=admin@localhost
SEED_ADMIN_PASSWORD=changeme
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator
