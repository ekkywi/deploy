generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- USER MANAGEMENT AND GLOBAL AUTHORIZATION ---

enum GlobalRole {
  SYSADMIN
  MANAGER
  DEVELOPER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

model User {
  id           String               @id @default(uuid())
  firstName    String
  lastName     String?
  email        String               @unique
  passwordHash String
  globalRole   GlobalRole           @default(DEVELOPER)
  status       AccountStatus        @default(PENDING)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  projectRoles ProjectRole[]
  envAccess    EnvironmentAccess[]
  auditLogs    AuditLog[]
}

// --- PROJECT MANAGEMENT AND SCOPED AUTHORIZATION ---

model Project {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  repoUrl       String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  webhookSecret String?

  environments  Environment[]
  members       ProjectRole[]
}

enum ProjectRoleType {
  OWNER
  EDITOR
  VIEWER
}

model ProjectRole {
  id        String          @id @default(uuid())
  userId    String
  projectId String
  role      ProjectRoleType @default(VIEWER)
  createdAt DateTime        @default(now())

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

// --- GLOBAL INFRASTRUCTURE (CONTROL PLANE) ---

model WorkerNode {
  id              String            @id @default(uuid())
  name            String            @unique
  ipAddress       String            @unique
  authToken       String   
  isActive        Boolean           @default(true)
  supportedTiers  EnvironmentTier[] @default([DEVELOPMENT, STAGING, PRODUCTION])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  deployments Deployment[]
}

// --- ENVIRONMENT AND ABSTRACTED LOGIC ---

enum EnvironmentTier {
  DEVELOPMENT
  STAGING
  PRODUCTION
}

enum StackType {
  NEXTJS
  LARAVEL
  NODEJS
}

enum LifeCycleStatus {
  ACTIVE
  SUSPENDED
  DELETING
  DELETED
}

model Environment {
  id            String                @id @default(uuid())
  projectId     String
  name          String
  domain        String?               @unique              
  stackType     StackType
  nodeVersion   String                @default("22")
  tier          EnvironmentTier       @default(DEVELOPMENT)
  branchName    String                @default("main")
  assignedPort  Int?                  @unique
  lifecycle     LifeCycleStatus        @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deployments   Deployment[]
  accessList    EnvironmentAccess[]
  variables     EnvironmentVariable[]

  @@unique([projectId, name])
}

model EnvironmentAccess {
  id            String      @id @default(uuid())
  userId        String
  environmentId String
  canDeploy     Boolean     @default(false)

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([userId, environmentId])
}

model EnvironmentVariable {
  id            String      @id @default(uuid())
  environmentId String
  key           String
  value         String
  isSecret      Boolean     @default(false)
  environment   Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([environmentId, key])
}

// --- DEPLOYMENT MANAGEMENT AND DYNAMIC RUNTIME ---

enum DeployStatus {
  PENDING
  BUILDING
  SUCCESS
  FAILED
}

model Deployment {
  id            String       @id @default(uuid())
  environmentId String
  workerNodeId  String?
  containerId   String?
  assignedPort  Int?
  status        DeployStatus @default(PENDING)
  logFilePath   String
  envVariables  Json?
  commitHash    String?
  errorMessage  String?      @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  environment   Environment  @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  workerNode    WorkerNode?  @relation(fields: [workerNodeId], references: [id], onDelete: SetNull)
}

// --- AUDIT TRAIL ---

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  actorName  String?
  action     String
  targetType String
  targetId   String
  ipAddress  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}